{
  "name": "platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./server/index.js",
    "build": "concurrently -g --prefix ' ' 'npm:build:client' 'npm:build:server'",
    "build:client": "vite build --ssrManifest --outDir server/dist",
    "build:server": "vite build --ssr src/entry-server.js --outDir server/dist-server",
    "serve": "NODE_ENV=production node ./server/index.js",
    "king-dev": "cd scripts; sh king-dev.sh",
    "king-dev-prod": "cd scripts; sh king-dev-prod.sh",
    "king-build": "npm run build",
    "king-prod-reload": "cd scripts; pm2 reload king-ecosystem.config.cjs",
    "king-launch-proxy": "cd scripts; sh king-launch-proxy.sh",
    "king-dev-prod-build": "cd scripts; sh king-dev-prod-build.sh",
    "king-serve": "vue-cli-service serve --mode=slotoking.development --watch --open",
    "king-serve-prod-build": "vue-cli-service serve --mode=slotoking.production --watch --open --report",
    "vlk-build": "npm run build",
    "vlk-dev": "cd scripts; sh vlk-dev.sh",
    "vlk-dev-prod": "cd scripts; sh vlk-dev-prod.sh",
    "vlk-dev-prod-build": "cd scripts; sh vlk-dev-prod-build.sh",
    "vlk-prod-reload": "cd scripts; pm2 reload vlk-ecosystem.config.cjs",
    "vlk-serve": "vue-cli-service serve --mode=vulkanoriginals.development --watch --open",
    "vlk-serve-prod-build": "vue-cli-service serve --mode=vulkanoriginals.production --watch --open --report",
    "king-doc": "cd scripts; sh king-doc.sh",
    "vlk-doc": "cd scripts; sh vlk-doc.sh",
    "docs": "jsdoc -d docs -c .jsdoc.js",
    "docs:all": "rm -rf docs* && npm run docs && npm run docs:docstrap && npm run docs:minami && npm run docs:tui",
    "docs:docstrap": "jsdoc -c .jsdoc-docstrap.js",
    "docs:minami": "jsdoc -c .jsdoc-minami.js",
    "docs:tui": "jsdoc -c .jsdoc-tui.js",
    "debug": "node --inspect-brk ./server/index.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --config .prettierrc.json --write 'src/**/*.{js,scss,vue}'",
    "lint:scss": "stylelint \"**/*.{css,scss,sass,html,vue}\" --ignore-path .stylelintignore  --fix",
    "styleguide": "vue-cli-service styleguidist",
    "styleguide:build": "vue-cli-service styleguidist:build",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@esotericsoftware/spine-player": "^4.2.23",
    "@popperjs/core": "^2.11.8",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.6.7",
    "body-parser": "^1.20.2",
    "centrifuge": "^3.1.2",
    "click-outside-vue3": "^4.0.1",
    "cookie-parser": "^1.4.6",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "deepmerge": "^4.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "express-useragent": "^1.0.15",
    "firebase": "^9.21.0",
    "fs-extra": "^11.2.0",
    "google-libphonenumber": "^3.2.34",
    "handlebars": "^4.7.8",
    "http-proxy-middleware": "^2.0.6",
    "isbot": "^5.1.0",
    "lru-cache": "^10.2.0",
    "pino": "^9.2.0",
    "query-string": "^8.2.0",
    "raygun": "^0.13.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "sanitize-html": "^2.13.0",
    "screenfull": "^5.1.0",
    "swiper": "^11.1.1",
    "uuid": "^9.0.1",
    "v-lazy-image": "^2.1.1",
    "vue": "^3.4.21",
    "vue-cleave-component": "^3.0.2",
    "vue-cookies": "^1.8.3",
    "vue-final-modal": "^3.4.11",
    "vue-i18n": "^9.9.1",
    "vue-number-animation": "^2.0.2",
    "vue-router": "^4.2.5",
    "vue-the-mask": "^0.11.1",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vue3-clipboard": "^1.0.0",
    "vue3-runtime-template": "^1.0.2",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.3",
    "@vitejs/plugin-legacy": "^5.4.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.17.0",
    "pino-pretty": "^11.2.1",
    "postcss": "^8.4.38",
    "postcss-html": "^1.7.0",
    "postcss-preset-env": "^9.5.14",
    "prettier": "^3.0.3",
    "pug": "^3.0.2",
    "sass": "^1.71.0",
    "stylelint": "^16.6.1",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.3.0",
    "terser": "^5.31.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.11",
    "vite-plugin-dynamic-import": "^1.5.0",
    "vite-plugin-static-copy": "^1.0.1",
    "vite-plugin-vue-devtools": "^7.2.1",
    "vite-svg-loader": "^5.1.0",
    "vue-pug-plugin": "^2.0.3"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8",
    "safari >= 10"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,scss,vue}": "prettier --write",
    "*.scss": "stylelint --config .stylelintrc.json --fix --output-file stylelint_errors.txt"
  }
}